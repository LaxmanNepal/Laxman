# Required for authenticated gateway access
LSP_GATEWAY_TOKEN=replace-with-a-long-random-token
LSP_HOST=127.0.0.1
LSP_PORT=8787

# Optional GitHub execution adapter
# Use a least-privilege token and never commit the real value.
GITHUB_TOKEN=
GITHUB_REPOSITORY=LaxmanNepal/Laxman
GITHUB_API_URL=https://api.github.com
